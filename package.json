{
  "name": "zenlo",
  "description": "Zenlo – trình quản lí hội thoại Zalo PC, tóm tắt hội thoại bằng AI",
  "version": "0.1.0",
  "private": true,
  "author": "stephit",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "standard",
    "zalo:install": "npm run build && node installer install",
    "zalo:dev": "npm run build && node installer dev",
    "zalo:status": "node installer status",
    "zalo:uninstall": "node installer uninstall"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.106.1",
    "standard": "^17.1.2"
  },
  "dependencies": {
    "@electron/asar": "3.3.1"
  },
  "standard": {
    "global": [
      "DEBUG",
      "localStorage",
      "MutationObserver",
      "requestAnimationFrame"
    ],
    "ignore": [
      "dist/"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
