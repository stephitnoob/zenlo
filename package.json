{
  "name": "zenlo",
  "description": "Zenlo – trình quản lí hội thoại cho Zalo PC và Zalo web, tóm tắt hội thoại bằng AI",
  "version": "0.3.1",
  "private": true,
  "author": "stephit",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "standard",
    "zalo:install": "npm run build && node installer install",
    "zalo:dev": "npm run build && node installer dev",
    "zalo:status": "node installer status",
    "zalo:uninstall": "node installer uninstall",
    "build:setup": "npm run build && node scripts/build-setup.mjs",
    "build:ext": "npm run build && node scripts/pack-ext.mjs",
    "build:ext-dev": "node scripts/build.mjs --ext-dev",
    "site": "node scripts/serve-site.mjs",
    "test": "npm run build && node test/unit/run.mjs && node test/gemini/run.mjs && node test/extension/run.mjs && node test/codex/run.mjs",
    "test:unit": "node test/unit/run.mjs",
    "test:codex": "npm run build && node test/codex/run.mjs",
    "test:gemini": "npm run build && node test/gemini/run.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.106.1",
    "standard": "^17.1.2"
  },
  "dependencies": {
    "@electron/asar": "3.3.1"
  },
  "standard": {
    "global": [
      "DEBUG",
      "ZENLO_WEB",
      "localStorage",
      "MutationObserver",
      "requestAnimationFrame"
    ],
    "ignore": [
      "dist/",
      "dist-ext/",
      "advertisement/"
    ]
  },
  "engines": {
    "node": ">=22.2"
  }
}
